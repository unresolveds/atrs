PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/atrs

# Transport / CORS
# Comma-separated list of allowed browser origins for cross-origin requests.
# Requests with no Origin header (curl, server-to-server) are always allowed.
# Defaults to the vite dev origins if unset.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# bcrypt work factor for password hashing (optional; default 12, clamped 10..15).
# BCRYPT_ROUNDS=12

# Root admin (seeded on first boot if no root admin exists)
ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_PASSWORD=change-me-strong-password
ROOT_ADMIN_NAME=Root Admin

# GitHub integration (optional)
# Key used to encrypt stored GitHub tokens at rest. Falls back to JWT_SECRET if
# unset; set a dedicated value so rotating one secret doesn't invalidate the other.
GITHUB_TOKEN_SECRET=change-me-to-a-long-random-string
# Override only for GitHub Enterprise Server (e.g. https://github.mycorp.com/api/v3).
# GITHUB_API_URL=https://api.github.com

# Cloudflare R2 media storage
# Used when Settings → System → Media Storage is set to "Cloudflare R2".
# Credentials belong HERE (or in the host platform's env vars) — never in
# app.config.json or git. Values entered in the settings UI take precedence.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=your-bucket-name
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Ollama (changelog generator / AI assist)
# Local daemon URL override (defaults to http://localhost:11434).
# OLLAMA_URL=http://localhost:11434
# Cloud-mode endpoint + API key; fallbacks when Settings leaves them blank.
# OLLAMA_CLOUD_URL=https://ollama.com/api/generate
# OLLAMA_CLOUD_KEY=your-ollama-cloud-api-key

# Changelog generator: local repo access (self-hosted only).
# The folder picker and git-based changelog generation are confined to this
# directory (defaults to the OS home dir). Set it to the parent folder holding
# your repos; paths outside it are rejected. No effect on Vercel.
# REPO_BROWSE_ROOT=C:\Users\you\repos


# Telegram visitor alerts (optional)
# When set, a Telegram message is sent to TELEGRAM_CHAT_ID every time a
# visitor loads the site (signed in or not) — one alert per browser session.
# Create a bot via @BotFather to get a token, message the bot once, then read
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-telegram-chat-id
# Freemius (optional) — used to pull uninstall/deactivation feedback per product.
# Product ("plugin") scope: Developer Dashboard → your product → Settings → Keys.
# The secret key never leaves the server; requests are HMAC-signed, not bearer.
# FREEMIUS_PRODUCT_ID=
# FREEMIUS_PUBLIC_KEY=pk_
# FREEMIUS_SECRET_KEY=sk_
